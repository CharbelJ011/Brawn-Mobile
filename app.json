{
  "expo": {
    "name": "Brawn",
    "slug": "brawn-mobile",
    "scheme": "brawn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brawn.mobile"
    },
    "android": {
      "package": "com.brawn.mobile"
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
