{
  "expo": {
    "name": "Brawn",
    "slug": "brawn-mobile",
    "scheme": "brawn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-secure-store"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.brawn.mobile",
      "associatedDomains": ["applinks:brawnapp.com"]
    },
    "android": {
      "package": "com.brawn.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "brawnapp.com",
              "pathPrefix": "/checkin/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
